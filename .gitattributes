# Keep patch hashes and exact context stable on Windows.
*.patch text eol=lf whitespace=-blank-at-eol

# Preserve the symbol export bytes used by generation receipts.
recomp/doraemon.syms.toml whitespace=-blank-at-eof

# Keep the Windows Gradle wrapper executable as a CRLF batch file.
android/gradlew.bat text eol=crlf whitespace=cr-at-eol

    {
      "id": "001236E1",
      "category": "item_description",
      "translation": "Put it on your hand and say \"Bang!\"\nto fire a blast of air."
    },
    {
      "id": "00123703",
      "category": "item_description",
      "translation": "Fires bursts of compressed air\ninstead of bullets to strike\nthe target."
    },
    {
      "id": "0012372D",
      "category": "item_description",
      "translation": "Any song or story heard through\nthis microphone will deeply\nmove the listener."
    },
    {
      "id": "0012375F",
      "category": "item_description",
      "translation": "Wear these gloves to beat even\nthe strongest opponent\nin a fistfight."
    },
    {
      "id": "00123785",
      "category": "item_description",
      "translation": "Throw it to scare enemies with\na deafening bang and a bright flash."
    },
    {
      "id": "001237AB",
      "category": "item_description",
      "translation": "Just put it on your head\nand you can fly with ease."
    },
    {
      "id": "001237CA",
      "category": "item_description",
      "translation": "Need a time-out? Press the switch\non this watch to stop time."
    },
    {
      "id": "001237FE",
      "category": "item_description",
      "translation": "Stick this on your belly\nto keep all kinds of misfortune\naway."
    },
    {
      "id": "0012382B",
      "category": "item_description",
      "translation": "Open the door to go anywhere,\nas long as the destination\nis on its built-in map."
    },
    {
      "id": "0012385C",
      "category": "item_description",
      "translation": "Place this hoop against any wall\nand you can pass right through it."
    },
    {
      "id": "0012387E",
      "category": "item_description",
      "translation": "Drink this and shout loudly\nto turn your voice into\nsolid objects."
    },
    {
      "id": "001238A0",
      "category": "item_description",
      "translation": "Anything caught in this light's\nbeam will shrink."
    },
    {
      "id": "001238BF",
      "category": "item_description",
      "translation": "Any animal that eats these\ndumplings will obey you."
    },
    {
      "id": "001238E2",
      "category": "item_description",
      "translation": "Put these tubes in your nose\nto breathe underwater."
    },
    {
      "id": "00123908",
      "category": "item_description",
      "translation": "Cover an object to turn its time\nforward or back."
    },
    {
      "id": "0012392D",
      "category": "item_description",
      "translation": "Rub this cream over your body\nto withstand water pressure\n10,000 meters deep."
    },
    {
      "id": "0012395F",
      "category": "item_description",
      "translation": "Plant this bean, and it will grow\ninto a giant beanstalk\nin an instant."
    },
    {
      "id": "00123985",
      "category": "item_description",
      "translation": "Shine this light on your body\nto adapt to any environment."

  "records": [
    {
      "id": "000ACBC0",
      "category": "system_message",
      "translation": "{F8:32}Контроллер{F7} не {F8:31}подключён{F7}.\n{F8:31}Подключите{F7} его к {F8:32}разъёму{F7},\nзатем снова {F8:32}включите питание{F7}."
    },
    {
      "id": "000ACC08",
      "category": "system_message",
      "translation": "{F8:32}EEPROM{F7} отсутствует или {F8:31}повреждена{F7}!"
    },
    {
      "id": "001236E1",
      "category": "item_description",
      "translation": "Надень на руку и скажи: «Бах!» -\nвылетит сгусток сжатого воздуха."
    },
    {
      "id": "00123703",
      "category": "item_description",
      "translation": "Вместо пули выстреливает сгустком\nвоздуха, который поражает цель."
    },
    {
      "id": "0012372D",
      "category": "item_description",
      "translation": "Любая песня или история, услышанная\nчерез этот микрофон, растрогает\nкого угодно."
    },
    {
      "id": "0012375F",
      "category": "item_description",
      "translation": "В этих перчатках можно победить\nв рукопашной даже самого\nсильного противника."
    },
    {
      "id": "00123785",
      "category": "item_description",
      "translation": "При броске создаёт оглушительный\nзвук и яркую вспышку, пугая врага."
    },
    {
      "id": "001237AB",
      "category": "item_description",
      "translation": "Надень его на голову -\nи сможешь свободно летать."
    },
    {
      "id": "001237CA",
      "category": "item_description",
      "translation": "Если захочется сказать: «Стоп!»,\nнажми кнопку на этих часах -\nи время остановится."
    },
    {
      "id": "001237FE",
      "category": "item_description",
      "translation": "Наклей её на живот, и она поможет\nизбежать любых несчастий."
    },
    {
      "id": "0012382B",
      "category": "item_description",
      "translation": "Открой дверь - и попадёшь куда\nугодно, кроме мест, которых нет\nна её карте."
    },
    {
      "id": "0012385C",
      "category": "item_description",
      "translation": "Приложи этот обруч к любой стене,\nчтобы пройти сквозь неё."
    },
    {
      "id": "0012387E",
      "category": "item_description",
      "translation": "Выпей его и крикни погромче -\nтвой голос превратится в твёрдые\nснаряды."
    },
    {
      "id": "001238A0",
      "category": "item_description",
      "translation": "Всё, что осветит этот фонарь,\nуменьшится."
    },
    {
      "id": "001238BF",
      "category": "item_description",
      "translation": "Любое животное, съев это лакомство,\nстанет послушным."
    },
    {
      "id": "001238E2",
      "category": "item_description",
      "translation": "Вставь эти трубки в нос,\nчтобы дышать под водой."
    },
    {
      "id": "00123908",
      "category": "item_description",
      "translation": "Перемещает время накрытого предмета\nв будущее или обратно в прошлое."
    },
    {
      "id": "0012392D",
      "category": "item_description",
      "translation": "Намажься кремом, чтобы выдержать\nдавление воды на глубине\nдесяти километров."
    },
    {
      "id": "0012395F",
      "category": "item_description",
      "translation": "Посади этот боб в землю,\nи он мгновенно вырастет\nв огромное бобовое дерево."
    },
    {
      "id": "00123985",
      "category": "item_description",
      "translation": "Свет этого фонаря позволяет телу\nприспособиться к любым условиям."
    },
    {
      "id": "001239AF",
      "category": "item_description",
      "translation": "Прикрепи этот штурвал к чему угодно,\nчтобы свободно этим управлять."
    },
    {
      "id": "001239DF",
      "category": "item_description",
      "translation": "Распылённый на облако газ делает\nего твёрдым, чтобы сверху можно\nбыло стоять."
    },
    {
      "id": "00123A09",
      "category": "item_description",
      "translation": "Эта жидкость на время улучшает\nсвойства любого предмета."
    },
    {
      "id": "00123A32",
      "category": "item_description",
      "translation": "Телевизор, на котором можно увидеть\nпрошлое или будущее."
    },
    {
      "id": "00123A4B",
      "category": "item_description",
      "translation": "Вставь фото одежды, наведи камеру\nна человека, нажми затвор -\nон переоденется."
    },
    {
      "id": "00123A85",
      "category": "item_description",
      "translation": "Капсула размером с теннисный мяч.\nВоткни её в землю - вырастет\nпоходный домик."
    },
    {
      "id": "00123ABA",
      "category": "item_description",
      "translation": "Съешь его, чтобы говорить\nс иностранцами и даже пришельцами."
    },
    {
      "id": "00123AE4",
      "category": "item_description",
      "translation": "Скажи в трубку: «Что, если мир\nстанет таким-то...» - и он\nдействительно изменится."
    },
    {
      "id": "00123B1E",
      "category": "item_description",
      "translation": "Показывает море или реку на\nчетырёхмерном экране. Можно\nрыбачить прямо в комнате."
    },
    {
      "id": "00123B4A",
      "category": "item_description",
      "translation": "Возвращает эхо точно в заданное\nвремя."
    },
    {
      "id": "00123B68",
      "category": "item_description",
      "translation": "Если у каждого есть такой телефон,\nможно говорить без соединяющей их\nнити."
    },
    {
      "id": "00123B90",
      "category": "item_description",
      "translation": "Надень эти туфли, чтобы войти\nв мир истории из книжки."
    },
    {
      "id": "00123BB4",
      "category": "item_description",
      "translation": "Мини-Дораэмон, как настоящий,\nдостаёт секретные гаджеты,\nно лишь миниатюрные."
    },
    {
      "id": "00123BE3",
      "category": "item_description",
      "translation": "Багги свободно ездит под водой.\nС его встроенным компьютером\nможно разговаривать."
    },
